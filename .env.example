# LLDAP service account. It must be in the lldap_admin group to edit other users' profiles.
LLDAP_USERNAME=tebonsma-api
LLDAP_PASSWORD=

# Sending mail later, which needs a client of its own at the login provider (see the README).
# Leave these empty to turn the feature off.
MAIL_OFFLINE_CLIENT_ID=
MAIL_OFFLINE_CLIENT_SECRET=
# 32 bytes: openssl rand -hex 32. Keep a copy: tokens written with another key can't be read.
MAIL_OFFLINE_KEY=

# Push notifications: npx web-push generate-vapid-keys. Keep the pair: browsers subscribed with
# one key won't take pushes signed with another. Leave these empty to turn push off.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# TebBet's bot makes markets on the news with Claude: a key from platform.claude.com. Leave it
# empty to turn that off. Set a spend limit on the key there as well.
ANTHROPIC_API_KEY=
