# Settings for deploy/deploy.sh. Lives at /etc/tebonsma-api-deploy.env on the host, readable by
# root only, since it holds the token.

# A fine-grained personal access token for this repository only, with Contents: read (to
# download the code) and Deployments: read and write (to record what is deployed).
GITHUB_TOKEN=

REPO=TEBONSMA/tebonsma-api

# Defaults, change them if the host is set up differently
#BRANCH=main
#APP_DIR=/opt/tebonsma-api
#CONTAINER=tebonsma-api
#IMAGE=tebonsma-api-tebonsma-api
#DB_FILE=/var/lib/docker/volumes/tebonsma-api_data/_data/tebonsma.db
#BACKUP_DIR=/opt/backups/tebonsma-api
#STATE_DIR=/var/lib/tebonsma-api-deploy
#ENVIRONMENT=production
#ENVIRONMENT_URL=https://api.tebonsma.no
#KEEP_BACKUP_DAYS=14
