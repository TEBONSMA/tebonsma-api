# Settings for deploy/deploy.sh. Lives at /etc/tebonsma-api-deploy.env on the host.

# The repository, and the read-only deploy key that may fetch it (its public half is added
# under the repository's Settings > Deploy keys)
REPO_URL=git@github.com:TEBONSMA/tebonsma-api.git
DEPLOY_KEY=/etc/tebonsma-api-deploy/id_ed25519

# Defaults, change them if the host is set up differently
#BRANCH=main
#APP_DIR=/opt/tebonsma-api
#CONTAINER=tebonsma-api
#IMAGE=tebonsma-api-tebonsma-api
#DB_FILE=/var/lib/docker/volumes/tebonsma-api_data/_data/tebonsma.db
#BACKUP_DIR=/opt/backups/tebonsma-api
#STATE_DIR=/var/lib/tebonsma-api-deploy
#KEEP_BACKUP_DAYS=14
